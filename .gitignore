node_modules
dist
.DS_Store
*.local

# Safety net: no API keys ever land in this repo.
# The demo takes the key at runtime, in the browser, and keeps it in sessionStorage only.
.env
.env.*
!.env.example

# The Musy design system is vendored for the #/musie page. Only the two folders
# the build actually imports are committed, so deploying the page does not also
# publish the internal docs, proof pages and screenshots to a public repo.
reference/*
!reference/musie260917/
reference/musie260917/*
!reference/musie260917/tokens/
!reference/musie260917/components/
# Layer 3 is ours, written into the package — versioned with the app that
# derived it. The package's own docs/ stays local.
!reference/musie260917/docs/
reference/musie260917/docs/*
!reference/musie260917/docs/10-layout.md
!reference/musie260917/docs/11-toast.md
!reference/musie260917/docs/12-component-gaps.md
!reference/musie260917/docs/13-draggable-list.md
